hd:hypo_banquan_yellow_emperor a hhto:CompetingHypothesis ;
    rdfs:label "黄帝炎帝阪泉之战传说（神话传说）"@zh ;
    hhto:epistemicStatus "FOLK_LEGEND"^^xsd:string ;
    hhto:supportedBy hd:attest_banquan_myth ;
