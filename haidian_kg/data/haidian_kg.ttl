hd:attest_banquan_myth a hhto:PlaceAttestation ;
    rdfs:label "黄帝阪泉之战传说"@zh ;
    hhto:epistemicNotes "远古部落神话传说，未有出土实物信史印证，严格禁止列为确证信史"@zh ;
    hhto:epistemicStatus "FOLK_LEGEND"^^xsd:string ;
    hhto:evidenceLevel "Level 5 (民间口碑传说)"^^xsd:string ;
    hhto:originalQuote "轩辕乃修德振兵……与炎帝战于阪泉之野，三战然后得其志"@zh ;
    hhto:recordedYear -100 ;
    rdfs:comment "断代: 西汉（追述远古神话） | 来源: 《史记·五帝本纪》"@zh .

hd:attest_gaoliangqiao_979_myth a hhto:PlaceAttestation ;
    rdfs:label "宋太宗中箭之高梁桥说"@zh ;
    hhto:epistemicNotes "时空错乱：979年高梁河之战时该处仅有古河道与野渡，高梁桥系元至元二十九年（1292）郭守敬所建，晚了313年"@zh ;
    hhto:epistemicStatus "DISPROVEN"^^xsd:string ;
    hhto:evidenceLevel "Level 6 (明确证伪伪说)"^^xsd:string ;
    hhto:originalQuote "讲宋太宗赵光义高梁河惨败，于高梁桥下乘驴车仓皇南逃"@zh ;
    hhto:recordedYear 1950 ;
    rdfs:comment "断代: 现代通俗评书 | 来源: 《通俗演义小说附会》"@zh .

hd:attest_gaoliangzha_1292 a hhto:PlaceAttestation ;
    rdfs:label "高梁闸"@zh ;
    hhto:epistemicStatus "VERIFIED"^^xsd:string ;
    hhto:evidenceLevel "Level 2 (一手官刻金石)"^^xsd:string ;
    hhto:originalQuote "又于高梁河创设水闸，节水利漕，赐名通惠河"@zh ;
    hhto:recordedYear 1292 ;
    rdfs:comment "断代: 元代（至元二十九年） | 来源: 《元史·郭守敬传》"@zh .

hd:attest_huangzhuang_hunt a hhto:PlaceAttestation ;
    rdfs:label "黄庄"@zh ;
    hhto:epistemicStatus "CONTESTED"^^xsd:string ;
    hhto:evidenceLevel "Level 3 (正史方志纪实)"^^xsd:string ;
    hhto:originalQuote "海淀南二里黄庄，明时或为皇庄之讹，或以黄土高阜得名，志家存疑"@zh ;
    hhto:recordedYear 1774 ;
    rdfs:comment "断代: 清代 | 来源: 《日下旧闻考卷一百》"@zh .

hd:attest_jingxi_map_1913 a hhto:PlaceAttestation ;
    rdfs:label "中关村"@zh ;
    hhto:epistemicNotes "推翻了‘中关村改名系1930年代陈垣独创提议’的单一学说"@zh ;
    hhto:epistemicStatus "VERIFIED"^^xsd:string ;
    hhto:evidenceLevel "Level 2 (一手官刻金石)"^^xsd:string ;
    hhto:originalQuote "海淀镇东二里图注标绘‘中关村’，明确标注为村落民居聚落"@zh ;
    hhto:recordedYear 1913 ;
    rdfs:comment "断代: 民国二年 | 来源: 《实测北京四郊图（京西图）》"@zh .

hd:attest_shuntian_xisanqi a hhto:PlaceAttestation ;
    rdfs:label "西三旗"@zh ;
    hhto:epistemicStatus "VERIFIED"^^xsd:string ;
    hhto:evidenceLevel "Level 3 (正史方志纪实)"^^xsd:string ;
    hhto:originalQuote "宛平北乡有西三旗、西二旗，相传明代卫所小旗分屯之地"@zh ;
    hhto:recordedYear 1885 ;
    rdfs:comment "断代: 清代（光绪十一年） | 来源: 《光绪顺天府志·地理志》"@zh .

hd:attest_xisanqi_manchu_myth a hhto:PlaceAttestation ;
    rdfs:label "西三旗源自满洲八旗三旗说"@zh ;
    hhto:epistemicNotes "严重史实错误：清代八旗驻防体系中绝无‘西三旗’之军制建置，一手顺天府志明确记载为明代卫所小旗军屯"@zh ;
    hhto:epistemicStatus "DISPROVEN"^^xsd:string ;
    hhto:evidenceLevel "Level 6 (明确证伪伪说)"^^xsd:string ;
    hhto:originalQuote "俗传西三旗为清代正黄、正白、正蓝上三旗驻军之地"@zh ;
    hhto:recordedYear 1980 ;
    rdfs:comment "断代: 现代通俗读物 | 来源: 《北京地名通俗民间讲义（错误说）》"@zh .

