hd:attest_anhe_republic_record a hhto:PlaceAttestation ;
    rdfs:label "安河桥"@zh ;
    hhto:epistemicNotes "【R11-4 拟托书证】《北平地名通志》**查无此书**（民国北平无此名义出版物，calibration 书目表亦无），引文含解说性断语非原书文句。E2 §1.5 冻结：石额『安和桥』确有旧料，但**近现代通行写『安河桥』，转换时间与机制待考**，不做『和/河通写』的确定性解释。保留原文供审计。"@zh ;
    hhto:epistemicStatus "DISPROVEN"^^xsd:string ;
    hhto:evidenceLevel "Level 6 (明确证伪伪说)"^^xsd:string ;
    hhto:originalQuote "安河桥在青龙桥东，因水流安恬、桥跨御河，俗名遂改作‘安河桥’"@zh ;
    hhto:recordedYear 1934 ;
    rdfs:comment "断代: 民国二十三年 | 来源: 《北平地名通志》"@zh .

hd:attest_anheqiao_stone_tablet a hhto:PlaceAttestation ;
    rdfs:label "安和桥"@zh ;
    hhto:epistemicNotes "【R11-3 拟托书证】E2 research.md §1 冻结：①石额『安和桥』确有旧料，但**近现代通行写『安河桥』，转换时间与机制待考**；②『安澜平和』之意仅 L3 地方文史说法，非档案；③改建石桥有两套记载（系统A 乾隆年间 L3/L4 vs 系统B 康熙五十九年1720 L1转引），**保留冲突不制造确定性**。原「1781＋乾隆御题＋取…之义」三者已拍死。保留原文供审计。"@zh ;
    hhto:epistemicStatus "DISPROVEN"^^xsd:string ;
    hhto:evidenceLevel "Level 6 (明确证伪伪说)"^^xsd:string ;
    hhto:originalQuote "桥成，改木为石，额曰‘安和桥’，取安和景泰之义"@zh ;
    hhto:recordedYear 1781 ;
    rdfs:comment "断代: 清代（乾隆四十六年） | 来源: 《安和桥额石题字》"@zh .

hd:attest_anheqiao_wood_c14 a hhto:PlaceAttestation ;
    rdfs:label "罗锅桥木桩BA10291"@zh ;
    hhto:epistemicNotes "全海淀水利古桥最强考古硬证据"@zh ;
    hhto:epistemicStatus "VERIFIED"^^xsd:string ;
    hhto:evidenceLevel "Level 1 (考古硬证据)"^^xsd:string ;
    hhto:originalQuote "在安和桥旧桥台下清理出密集柏木地钉，标本BA10291碳十四定年测定为明代，证实该处明代已建有大型木构拱桥跨水枢纽"@zh ;
    hhto:recordedYear 2009 ;
    rdfs:comment "断代: 明代（经碳十四测定为明代中晚期原桩） | 来源: 《安河桥古水利遗址考古发掘报告》"@zh .

hd:attest_baijiatuan_caoxueqin a hhto:PlaceAttestation ;
    rdfs:label "白家疃"@zh ;
    hhto:epistemicStatus "CONTESTED"^^xsd:string ;
    hhto:evidenceLevel "Level 4 (近代学界考订)"^^xsd:string ;
    hhto:originalQuote "曹雪芹乾隆二十三年至二十四年初曾徙居西山白家疃著书行医（居留约一年，非定居）"@zh ;
    hhto:recordedYear 1978 ;
    rdfs:comment "断代: 现代学术专著 | 来源: 《白家疃怡亲王交辉园题记与曹雪芹行迹考》"@zh .

hd:attest_baijiatuan_founding a hhto:PlaceAttestation ;
    rdfs:label "白家疃"@zh ;
    hhto:epistemicStatus "CONTESTED"^^xsd:string ;
    hhto:evidenceLevel "Level 5 (民间口碑传说)"^^xsd:string ;
    hhto:originalQuote "白家疃成村于辽金或更早；一说为明洪武屯田移民聚落（两说并存，无定向书证）"@zh ;
    hhto:recordedYear 1992 ;
    rdfs:comment "断代: 现代 | 来源: 《海淀区地名志（1992）与现代通行说法》"@zh .

hd:attest_baijiatuan_yixianqin a hhto:PlaceAttestation ;
    rdfs:label "白家疃"@zh ;
    hhto:epistemicStatus "VERIFIED"^^xsd:string ;
    hhto:evidenceLevel "Level 1 (考古硬证据)"^^xsd:string ;
    hhto:originalQuote "怡贤亲王祠残碑（碑额存「怡贤亲王祠」五字，白家疃境内，海淀区文物保护单位）"@zh ;
    hhto:recordedYear 1732 ;
    rdfs:comment "断代: 清雍正十年 | 来源: 《怡贤亲王祠残碑碑额（实物）》"@zh .

hd:attest_chengfu_shunzhi a hhto:PlaceAttestation ;
    rdfs:label "成府"@zh ;
    hhto:epistemicStatus "VERIFIED"^^xsd:string ;
    hhto:evidenceLevel "Level 4 (近代学界考订)"^^xsd:string ;
    hhto:originalQuote "成府旧称陈府，相传明末崇祯田贵妃戚畹陈氏别墅所在地，村落早废而路名犹存"@zh ;
    hhto:recordedYear 1930 ;
