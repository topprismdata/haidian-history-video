    hhto:coordinatesWGS84 "116.27,40.01"^^xsd:string ;
    rdfs:comment "2009年出土明代碳十四定年木桩BA10291的水利枢纽节点"@zh .

hd:feat_liulihe_site a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
