@prefix hd: <http://history.haidian.gov.cn/resource/> .
@prefix hhto: <http://history.haidian.gov.cn/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hhto: a owl:Ontology ;
    rdfs:label "海淀历史地名知识图谱本体 (HHTO)"@zh ;
    rdfs:comment "面向海淀区全域历史地理、地名演变、史料考订与认识论分层的领域本体模型"@zh ;
    owl:versionInfo "1.0.0" .

hhto:attestedIn a owl:ObjectProperty ;
    rdfs:label "见载书证于"@zh ;
    rdfs:domain hhto:Toponym ;
    rdfs:range hhto:PlaceAttestation .

hhto:competesWith a owl:ObjectProperty ;
    rdfs:label "竞争互斥假说"@zh ;
    rdfs:domain hhto:CompetingHypothesis ;
    rdfs:range hhto:CompetingHypothesis .

hhto:coordinatesWGS84 a owl:DatatypeProperty ;
    rdfs:label "WGS84经纬度"@zh ;
    rdfs:domain hhto:PhysicalFeature ;
    rdfs:range xsd:string .

hhto:disprovenBy a owl:ObjectProperty ;
    rdfs:label "由该史料证据证伪"@zh ;
    rdfs:domain hhto:CompetingHypothesis ;
    rdfs:range hhto:PlaceAttestation .

hhto:epistemicStatus a owl:DatatypeProperty ;
    rdfs:label "认识论确证状态"@zh ;
    rdfs:comment "VERIFIED (确证), CONTESTED (争议), FOLK_LEGEND (传说), DISPROVEN (证伪)"@zh ;
    rdfs:domain hhto:PlaceAttestation ;
    rdfs:range xsd:string .

hhto:evidenceLevel a owl:DatatypeProperty ;
    rdfs:label "六级证据层级"@zh ;
    rdfs:domain hhto:PlaceAttestation ;
    rdfs:range xsd:string .

hhto:evolutionTriggeredBy a owl:ObjectProperty ;
    rdfs:label "由该事件触发"@zh ;
    rdfs:domain hhto:Toponym ;
    rdfs:range hhto:ToponymEvolutionEvent .

hhto:evolvedFrom a owl:ObjectProperty ;
    rdfs:label "承袭演变自"@zh ;
    rdfs:domain hhto:Toponym ;
    rdfs:range hhto:Toponym .

hhto:fromSource a owl:ObjectProperty ;
    rdfs:label "文献出处为"@zh ;
    rdfs:domain hhto:PlaceAttestation ;
    rdfs:range hhto:SourceDocument .

hhto:locatedAtFeature a owl:ObjectProperty ;
    rdfs:label "物理空间坐落于"@zh ;
    rdfs:domain hhto:AdministrativeUnit ;
    rdfs:range hhto:PhysicalFeature .

hhto:namedAs a owl:ObjectProperty ;
    rdfs:label "定名为"@zh ;
    rdfs:domain hhto:AdministrativeUnit ;
    rdfs:range hhto:Toponym .

hhto:originalQuote a owl:DatatypeProperty ;
    rdfs:label "史料原始引文"@zh ;
    rdfs:domain hhto:PlaceAttestation ;
    rdfs:range xsd:string .

hhto:phoneticPinyin a owl:DatatypeProperty ;
    rdfs:label "汉语拼音读音"@zh ;
    rdfs:domain hhto:Toponym ;
    rdfs:range xsd:string .

hhto:recordedYear a owl:DatatypeProperty ;
    rdfs:label "书证记录公元年份"@zh ;
    rdfs:domain hhto:PlaceAttestation ;
    rdfs:range xsd:integer .

hhto:sourceToponym a owl:ObjectProperty ;
    rdfs:label "演变前源地名"@zh ;
    rdfs:domain hhto:ToponymEvolutionEvent ;
    rdfs:range hhto:Toponym .

hhto:standardForm a owl:DatatypeProperty ;
    rdfs:label "标准书写形式"@zh ;
    rdfs:domain hhto:Toponym ;
    rdfs:range xsd:string .

hhto:supportedBy a owl:ObjectProperty ;
    rdfs:label "由该书证支持"@zh ;
    rdfs:domain hhto:CompetingHypothesis ;
    rdfs:range hhto:PlaceAttestation .

hhto:targetToponym a owl:ObjectProperty ;
    rdfs:label "演变后目标地名"@zh ;
    rdfs:domain hhto:ToponymEvolutionEvent ;
    rdfs:range hhto:Toponym .

hd:feat_chexiangqu_canal a hhto:PhysicalFeature,
        hhto:Watercourse ;
    rdfs:label "曹魏车箱渠水利引水古道"@zh ;
    hhto:coordinatesWGS84 "116.3,39.92"^^xsd:string ;
    rdfs:comment "公元250年魏刘靖于石景山筑戾陵堰引水，开车箱渠；渠身横穿海淀南部（八里庄、翠微路一带，属渠路考订推断，非碑文所载），据《水经注》卷十四「水流乘車箱渠，自薊西北逕昌平，東盡漁陽潞縣」；灌溉规模以实文为准（岁灌二千顷，后改定田五千九百三十顷）"@zh .

hd:feat_diaoyutai_lake a hhto:PhysicalFeature,
        hhto:Wetland ;
    rdfs:label "钓鱼台泉池旧迹（明人记为金主游幸处）"@zh ;
    hhto:coordinatesWGS84 "116.33,39.91"^^xsd:string ;
    rdfs:comment "明人记金代此处有泉有池有台（「金王鬱釣魚臺」「金主逰幸處」），元时称玉渊潭、为丁氏园池。今址为后世园林与御碑，金代水面范围与水源构成均未考。"@zh .

hd:feat_donghulin_site a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "门头沟东胡林人永定河阶地遗址"@zh ;
    hhto:coordinatesWGS84 "115.71,39.98"^^xsd:string ;
    rdfs:comment "距今约1万至9000年新石器早期人类过渡期墓葬与最早陶器出土地"@zh .

hd:feat_guangyuanzha_site a hhto:HydraulicFacility,
        hhto:PhysicalFeature ;
    rdfs:label "广源闸水利遗址"@zh ;
    hhto:coordinatesWGS84 "116.31,39.94"^^xsd:string ;
    rdfs:comment "元代长河节制闸，通惠河闸系之首（至元二十九年 1292 工程）；建年双徽：1289《水部备考》转引称建／1292《元史》通惠河工程开工列入闸系；元史实名见《元史·河渠志》闸名序列「廣源牐」"@zh .

hd:feat_linshuogong_site a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "隋幽州临朔宫（遗址未定位）"@zh ;
    hhto:coordinatesWGS84 "0.0,0.0"^^xsd:string ;
    rdfs:comment "隋大业七年（611）四月炀帝「至涿郡之臨朔宮」（《隋书·炀帝纪》实文）。**宫址至今无考古定位，本库不赋坐标**；「控扼军都关道」「海淀平原为西北拱卫与军马牧草供应区」为现代推测，无一手书证。"@zh .

hd:feat_longbeicun_weir a hhto:HydraulicFacility,
        hhto:PhysicalFeature ;
    rdfs:label "白浮堰龙背村段古水利遗构（待考）"@zh ;
    hhto:coordinatesWGS84 "116.27,40.03"^^xsd:string ;
    rdfs:comment "龙背村一带白浮引水线路上的待考地面遗存；无实物勘测档案支撑，不得作元代堰堤实体定性（L1 已撤），更禁「全国唯一存世」；白浮泉引水系统元延祐元年（1314）起已淤塞（E29）"@zh .

hd:feat_qinghe_han_tombs a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "海淀清河汉代墓葬聚落遗址"@zh ;
    hhto:coordinatesWGS84 "116.34,40.03"^^xsd:string ;
    rdfs:comment "两汉时期清河古道大型砖室与土坑墓葬群，出土陶壶鼎与五铢钱，证明汉代聚落繁盛"@zh .

hd:feat_shangzhai_site a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "平谷上宅新石器文化遗址"@zh ;
    hhto:coordinatesWGS84 "117.15,40.17"^^xsd:string ;
    rdfs:comment "距今约7500至6000年北京最早定居农业陶器与石磨盘聚落"@zh .

hd:feat_taizhouwu_dock a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "太舟坞古泊船凹岸台地"@zh ;
    hhto:coordinatesWGS84 "116.18,40.04"^^xsd:string ;
    rdfs:comment "西山山麓山前坡水地带，元代白浮引水河道附近之船坞台地"@zh .

hd:feat_wangfujing_paleo a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "王府井东方广场旧石器晚期古营地"@zh ;
    hhto:coordinatesWGS84 "116.41,39.91"^^xsd:string ;
    rdfs:comment "距今约2.5万年北京平原中心古人类季节性狩猎火塘营地"@zh .

hd:feat_yiguangsi_site a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "海淀四季青遗光寺新石器石器采集地（存疑）"@zh ;
    hhto:coordinatesWGS84 "116.26,39.95"^^xsd:string ;
    rdfs:comment "遗光寺村西山山前台地（疑有新石器时代石器采集点，查无著录，存疑待考）"@zh .

hd:feat_yuquanshan a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "玉泉山山体与泉源"@zh ;
    hhto:coordinatesWGS84 "116.25,39.99"^^xsd:string ;
    rdfs:comment "天下第一泉玉泉水源地，金代芙蓉殿、清代静明园所在地"@zh .

hd:feat_zhoukoudian a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "周口店龙骨山古人类洞穴遗址"@zh ;
    hhto:coordinatesWGS84 "115.93,39.73"^^xsd:string ;
    rdfs:comment "距今约77万至20万年北京直立人及3万年山顶洞人栖居地，世界古人类发源圣地"@zh .

hd:top_baijiatuan a hhto:Toponym ;
    rdfs:label "白家疃"@zh ;
    hhto:attestedIn hd:attest_baijiatuan_caoxueqin,
        hd:attest_baijiatuan_founding,
        hd:attest_baijiatuan_yixianqin ;
    hhto:phoneticPinyin "bái jiā tuǎn"^^xsd:string ;
    hhto:standardForm "白家疃"^^xsd:string .

hd:top_banquan a hhto:Toponym ;
    rdfs:label "阪泉"@zh ;
    hhto:attestedIn hd:attest_banquan_myth ;
    hhto:hasHypothesis hd:hypo_banquan_yellow_emperor ;
    hhto:phoneticPinyin "bǎn quán"^^xsd:string ;
    hhto:standardForm "阪泉"^^xsd:string .

hd:top_chexiangqu a hhto:Toponym ;
    rdfs:label "车箱渠"@zh ;
    hhto:attestedIn hd:attest_sanguozhi_liujing ;
    hhto:phoneticPinyin "chē xiāng qú"^^xsd:string ;
    hhto:standardForm "车箱渠"^^xsd:string .

hd:top_diaoyutai a hhto:Toponym ;
    rdfs:label "钓鱼台"@zh ;
    hhto:attestedIn hd:attest_diaoyutai_dijing ;
    hhto:phoneticPinyin "diào yú tái"^^xsd:string ;
    hhto:standardForm "钓鱼台"^^xsd:string .

hd:top_donghulin a hhto:Toponym ;
    rdfs:label "东胡林"@zh ;
    hhto:attestedIn hd:attest_donghulin_pottery ;
    hhto:phoneticPinyin "dōng hú lín"^^xsd:string ;
    hhto:standardForm "东胡林"^^xsd:string .

hd:top_guajiatun a hhto:Toponym ;
    rdfs:label "挂甲屯"@zh ;
    hhto:attestedIn hd:attest_guajiatun_chenyuan ;
    hhto:phoneticPinyin "guà jiǎ tún"^^xsd:string ;
    hhto:standardForm "挂甲屯"^^xsd:string .

hd:top_guangyuanzha a hhto:Toponym ;
    rdfs:label "广源闸"@zh ;
    hhto:attestedIn hd:attest_guangyuanzha_stele ;
    hhto:phoneticPinyin "guǎng yuán zhá"^^xsd:string ;
    hhto:standardForm "广源闸"^^xsd:string .

hd:top_hongqingsi a hhto:Toponym ;
    rdfs:label "洪庆寺"@zh ;
    hhto:evolvedFrom hd:top_shuanshansi ;
    hhto:phoneticPinyin "hóng qìng sì"^^xsd:string ;
    hhto:standardForm "洪庆寺"^^xsd:string .

hd:top_huangzhuang a hhto:Toponym ;
    rdfs:label "黄庄"@zh ;
    hhto:attestedIn hd:attest_huangzhuang_hunt ;
    hhto:hasHypothesis hd:hypo_huangzhuang_emperor ;
    hhto:phoneticPinyin "huáng zhuāng"^^xsd:string ;
    hhto:standardForm "黄庄"^^xsd:string .

hd:top_longbeicun a hhto:Toponym ;
    rdfs:label "龙背村"@zh ;
    hhto:attestedIn hd:attest_longbeicun_weir_site ;
    hhto:phoneticPinyin "lóng bèi cūn"^^xsd:string ;
    hhto:standardForm "龙背村"^^xsd:string .

hd:top_shangzhai a hhto:Toponym ;
    rdfs:label "上宅"@zh ;
    hhto:attestedIn hd:attest_shangzhai_agriculture ;
    hhto:phoneticPinyin "shàng zhái"^^xsd:string ;
    hhto:standardForm "上宅"^^xsd:string .

hd:top_taizhouwu a hhto:Toponym ;
    rdfs:label "太舟坞"@zh ;
    hhto:attestedIn hd:attest_taizhouwu_dock_study ;
    hhto:evolvedFrom hd:top_daizhou_name ;
    hhto:hasHypothesis hd:hypo_taizhouwu_dock,
        hd:hypo_taizhouwu_tang ;
    hhto:phoneticPinyin "tài zhōu wù"^^xsd:string ;
    hhto:standardForm "太舟坞"^^xsd:string .

hd:top_wangfujing a hhto:Toponym ;
    rdfs:label "王府井"@zh ;
    hhto:attestedIn hd:attest_wangfujing_camp ;
    hhto:phoneticPinyin "wáng fǔ jǐng"^^xsd:string ;
    hhto:standardForm "王府井"^^xsd:string .

hd:top_wanshoushan hhto:attestedIn hd:attest_wanshoushan_rixia .

hd:top_wofosi a hhto:Toponym ;
    rdfs:label "卧佛寺"@zh ;
    hhto:evolvedFrom hd:top_sifangpujue ;
    hhto:phoneticPinyin "wò fó sì"^^xsd:string ;
    hhto:standardForm "卧佛寺"^^xsd:string .

hd:top_xiangshan hhto:attestedIn hd:attest_xiangshan_jinshi .

hd:top_yiguangsi a hhto:Toponym ;
    rdfs:label "遗光寺"@zh ;
    hhto:attestedIn hd:attest_yiguangsi_axe ;
    hhto:phoneticPinyin "yí guāng sì"^^xsd:string ;
    hhto:standardForm "遗光寺"^^xsd:string .

hd:top_yongansi a hhto:Toponym ;
    rdfs:label "永安寺"@zh ;
    hhto:evolvedFrom hd:top_shouanchanlin ;
    hhto:phoneticPinyin "yǒng ān sì"^^xsd:string ;
    hhto:standardForm "永安寺"^^xsd:string .

hd:top_yuquanshan hhto:attestedIn hd:attest_yuquanshan_jinshi .

hd:top_zhaoxiaoshi a hhto:Toponym ;
    rdfs:label "昭孝寺"@zh ;
    hhto:evolvedFrom hd:top_shuanshansi ;
    hhto:phoneticPinyin "zhāo xiào sì"^^xsd:string ;
    hhto:standardForm "昭孝寺"^^xsd:string .

hd:top_zhongguantun a hhto:Toponym ;
    rdfs:label "中官屯"@zh ;
    hhto:attestedIn hd:attest_zhongguantun_map ;
    hhto:evolvedFrom hd:top_zhongguancun_eunuch ;
    hhto:phoneticPinyin "zhōng guān tún"^^xsd:string ;
    hhto:standardForm "中官屯"^^xsd:string .

hd:top_zhoukoudian a hhto:Toponym ;
    rdfs:label "周口店"@zh ;
    hhto:attestedIn hd:attest_shandingdong_needle,
        hd:attest_zhoukoudian_peking_man ;
    hhto:phoneticPinyin "zhōu kǒu diàn"^^xsd:string ;
    hhto:standardForm "周口店"^^xsd:string .

hd:unit_cas_zhongguancun a hhto:AdministrativeUnit,
        hhto:ModernInstitution ;
    rdfs:label "中国科学院中关村科学城科研园区"@zh ;
    hhto:locatedAtFeature hd:feat_wanquanhe ;
    hhto:validTimeStart 1953 ;
    rdfs:comment "1953年新中国政务院确定之全国最高科学学术中心驻地，近代中国科学第一城"@zh .

hd:unit_changchunyuan a hhto:AdministrativeUnit,
        hhto:ImperialGarden ;
    rdfs:label "清康熙畅春园"@zh ;
    hhto:locatedAtFeature hd:feat_wanquanhe ;
    hhto:validTimeEnd 1860 ;
    hhto:validTimeStart 1687 ;
    rdfs:comment "清圣祖康熙避喧听政之首座皇家御园，咸丰十年遭英法联军焚毁"@zh .

hd:unit_cishousi_temple a hhto:AdministrativeUnit,
        hhto:ReligiousSite ;
    rdfs:label "明代慈寿寺与八里庄玲珑塔"@zh ;
    hhto:locatedAtFeature hd:feat_changhe ;
    hhto:namedAs hd:top_cishousi ;
    hhto:validTimeStart 1576 ;
    rdfs:comment "明神宗圣母慈圣皇太后出资敕建，京西八里庄地标性密檐塔"@zh .

hd:unit_daizhou_garrison a hhto:AdministrativeUnit,
        hhto:MilitaryGarrison ;
    rdfs:label "唐代羁縻带州（寄治昌平县清水店，地望三说并存）"@zh ;
    hhto:locatedAtFeature hd:feat_gaolianghe ;
    hhto:namedAs hd:top_daizhou_name ;
    hhto:validTimeEnd 755 ;
    hhto:validTimeStart 645 ;
    rdfs:comment "《旧唐书》卷三十九：贞观十九年（645）于营州界内置，处契丹乙失革部落；万岁通天元年迁青州安置；神龙初放还，隶幽州都督。孤竹县「旧治营州界，州陷契丹后，寄治于昌平县之清水店，为州治」。**清水店今地三说并存（阳坊/太舟坞/清水店），本库未考得定论。**"@zh .

hd:unit_dayouzhuang_village a hhto:AdministrativeUnit,
        hhto:Settlement ;
    rdfs:label "大有庄（清代改名村落）"@zh ;
    hhto:locatedAtFeature hd:feat_wanshoushan ;
    hhto:namedAs hd:top_qiongbajia ;
    rdfs:comment "皇家园林/仓廪/马政体系服务的村落；清初曾称『穷八家』，乾隆朝官书已作『大有庄』（《日下旧闻考》卷100，L1）。❌ 不得写成『乾隆1750御赐改名』的已确证事实——赐名说属 L3 据载层"@zh .

hd:unit_dazhongsi_temple a hhto:AdministrativeUnit,
        hhto:ReligiousSite ;
    rdfs:label "清雍正觉生寺（大钟寺）"@zh ;
    hhto:locatedAtFeature hd:feat_gaolianghe ;
    hhto:namedAs hd:top_jueshengsi ;
    hhto:validTimeStart 1733 ;
    rdfs:comment "雍正十一年敕建祈雨行宫禅寺，乾隆十六年将万寿寺永乐大钟移置于此"@zh .

hd:unit_dongsimu_tomb a hhto:AdministrativeUnit,
        hhto:BurialGround ;
    rdfs:label "明代董四墓皇室茔地"@zh ;
    hhto:locatedAtFeature hd:feat_xiangshan ;
    hhto:namedAs hd:top_dongsimu ;
    hhto:validTimeStart 1500 ;
    rdfs:comment "明代皇室墓地，后演变为看坟户聚居村落并盛产贡御之桃"@zh .

hd:unit_guangyang_commandery a hhto:AdministrativeUnit,
        hhto:Settlement ;
    rdfs:label "秦汉广阳郡与西汉广阳国蓟县"@zh ;
    hhto:locatedAtFeature hd:feat_gaolianghe ;
    hhto:namedAs hd:top_guangyang ;
    hhto:validTimeEnd 220 ;
    hhto:validTimeStart -221 ;
    rdfs:comment "秦汉幽州刺史部监察与统属之都邑核心，海淀平原全境隶属广阳郡蓟县管辖"@zh .

hd:unit_haidian_town a hhto:AdministrativeUnit,
        hhto:Settlement ;
    rdfs:label "元代海店驿路商贸聚落"@zh ;
    hhto:locatedAtFeature hd:feat_wanquanhe ;
    hhto:namedAs hd:top_haidian_dian1 ;
    hhto:validTimeStart 1260 ;
    rdfs:comment "元大都城西北二十里通往居庸关大道的驿路水滨客商聚落"@zh .

hd:unit_jianruiying_garrison a hhto:AdministrativeUnit,
        hhto:MilitaryGarrison ;
    rdfs:label "香山健锐营八旗云梯特种部队"@zh ;
    hhto:locatedAtFeature hd:feat_xiangshan ;
    hhto:validTimeStart 1749 ;
    rdfs:comment "乾隆平定大小金川特设之精锐部队，营房按八旗翼长排列，广筑演武石碉楼（官书数：卷102馆臣按『共计六十有七』；逐旗数六十六，两说并存。现存座数无官方测绘档，不列）"@zh .

hd:unit_jicheng_capital a hhto:AdministrativeUnit,
        hhto:Settlement ;
    rdfs:label "先秦蓟国故都与战国燕都蓟城"@zh ;
    hhto:locatedAtFeature hd:feat_gaolianghe ;
    hhto:namedAs hd:top_jicheng ;
    hhto:validTimeEnd -221 ;
    hhto:validTimeStart -1046 ;
    rdfs:comment "西周初封蓟国、后为战国七雄燕国北都，位于今广安门内外，为北京建城古核"@zh .

hd:unit_jicheng_suburb a hhto:AdministrativeUnit,
        hhto:Settlement ;
    rdfs:label "蓟城西北郊农耕水利鄙野"@zh ;
    hhto:locatedAtFeature hd:feat_gaolianghe ;
    hhto:namedAs hd:top_gaolianghe ;
    hhto:validTimeStart -1046 ;
    rdfs:comment "先秦战国燕国蓟城西北部，沿高梁河水系分布的古农耕原野"@zh .

hd:unit_jin_zhongdu a hhto:AdministrativeUnit,
        hhto:Settlement ;
    rdfs:label "金中都大兴府（北京正式建都之始）"@zh ;
    hhto:locatedAtFeature hd:feat_gaolianghe ;
