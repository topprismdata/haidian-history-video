hd:feat_yangtaishan a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "旸台山（今阳台山）麓北安河一带"@zh ;
    hhto:coordinatesWGS84 "116.07,40.04"^^xsd:string ;
    rdfs:comment "辽咸雍四年（1068）《暘臺山清水院創造藏經記》碑所记清水院山名，今海淀北安河大觉寺所在山麓"@zh .

hd:hypo_banquan_yellow_emperor a hhto:CompetingHypothesis ;
    rdfs:label "黄帝炎帝阪泉之战传说（神话传说）"@zh ;
    hhto:epistemicStatus "FOLK_LEGEND"^^xsd:string ;
    hhto:supportedBy hd:attest_banquan_myth ;
    rdfs:comment "《史记》所载黄帝与炎帝阪泉之战，民间附会于北京延庆或涿鹿，属于部落联盟神话传说而非确证信史"@zh .

hd:hypo_gaoliangqiao_979 a hhto:CompetingHypothesis ;
    rdfs:label "高梁桥宋辽高梁河之战战场桥说（伪说）"@zh ;
    hhto:disprovenBy hd:attest_gaoliangzha_1292 ;
    hhto:epistemicStatus "DISPROVEN"^^xsd:string ;
    hhto:supportedBy hd:attest_gaoliangqiao_979_myth ;
    rdfs:comment "民间小说演义赵光义于高梁桥下乘驴车败逃"@zh .

hd:hypo_huangzhuang_emperor a hhto:CompetingHypothesis ;
    rdfs:label "黄庄源于明代皇庄讹变说"@zh ;
    hhto:epistemicStatus "CONTESTED"^^xsd:string ;
    hhto:supportedBy hd:attest_huangzhuang_hunt ;
    rdfs:comment "坊间与部分方志推论黄庄为明代皇家庄田‘皇庄’谐音字样演化"@zh .

hd:hypo_taizhouwu_dock a hhto:CompetingHypothesis ;
    rdfs:label "太舟坞源于元代白浮引水河道船坞说"@zh ;
    hhto:epistemicStatus "CONTESTED"^^xsd:string ;
    hhto:supportedBy hd:attest_taizhouwu_dock_study ;
    rdfs:comment "太舟坞地处元代白浮瓮山河漕运停泊带，「太舟坞」实为大船泊坞之地形实录（唯一书证查无实书，本库未考得可核出处）"@zh .

hd:hypo_taizhouwu_tang a hhto:CompetingHypothesis ;
    rdfs:label "太舟坞源于唐代羁縻带州音转说"@zh ;
    hhto:epistemicStatus "CONTESTED"^^xsd:string ;
    hhto:supportedBy hd:attest_daizhou_tang_record ;
    rdfs:comment "唐贞观十九年（645）置羁縻带州，州陷契丹后寄治昌平县清水店，太舟坞即带州之长久音转（清水店今地三说并存，本说未证）"@zh .

hd:hypo_xisanqi_manchu a hhto:CompetingHypothesis ;
    rdfs:label "西三旗源自清代满洲八旗驻防说（伪说）"@zh ;
    hhto:disprovenBy hd:attest_shuntian_xisanqi ;
    hhto:epistemicStatus "DISPROVEN"^^xsd:string ;
    hhto:supportedBy hd:attest_xisanqi_manchu_myth ;
    rdfs:comment "坊间传闻西三旗为满洲上三旗驻军兵营"@zh .

hd:hypo_zgc_chenyuan_alone a hhto:CompetingHypothesis ;
    rdfs:label "中关村定名陈垣独创提议说"@zh ;
    hhto:disprovenBy hd:attest_jingxi_map_1913 ;
    hhto:epistemicStatus "CONTESTED"^^xsd:string ;
    rdfs:comment "相传1930年代辅仁大学校长陈垣首次提议将中官村改写为中关村"@zh .

