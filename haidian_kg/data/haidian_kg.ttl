hd:unit_landianchang_town a hhto:AdministrativeUnit,
        hhto:MilitaryGarrison ;
    rdfs:label "蓝靛厂街市与外火器营"@zh ;
    hhto:locatedAtFeature hd:feat_changhe ;
    hhto:namedAs hd:top_landianchang_dye ;
    hhto:validTimeStart 1770 ;
