hd:attest_guangyuanzha_stele a hhto:PlaceAttestation ;
    rdfs:label "广源闸"@zh ;
    hhto:epistemicNotes "广源闸之名有元史实名，非后人追记（E16 直核）。建年取 E16 双徽口径：「1289：《水部备考》转引称建」／「1292：《元史》通惠河工程开工，广源闸列入其闸系」——《元史》无「广源闸建于1292」一句，禁单年定论、禁「700 多年历史」。原「广源闸重修碑记」已判死，原文见 haidian_kg/QUARANTINE.md。"@zh ;
    hhto:epistemicStatus "VERIFIED"^^xsd:string ;
    hhto:evidenceLevel "Level 2 (一手官刻金石)"^^xsd:string ;
    hhto:originalQuote "其壩牐之名曰：廣源牐"@zh ;
