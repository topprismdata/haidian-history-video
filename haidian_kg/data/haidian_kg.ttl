    hhto:phoneticPinyin "qióng bā jiā"^^xsd:string ;
    hhto:standardForm "穷八家"^^xsd:string .

hhto:EuphemisticRenamingEvent a owl:Class ;
    rdfs:label "文人雅化避嫌更名事件"@zh ;
    rdfs:subClassOf hhto:ToponymEvolutionEvent .

hd:top_haidian_dian1 a hhto:Toponym ;
    rdfs:label "海店"@zh ;
    hhto:attestedIn hd:attest_haidian_1260 ;
    hhto:evolutionTriggeredBy hd:evt_haidian_creation ;
    hhto:phoneticPinyin "hǎi diàn"^^xsd:string ;
    hhto:standardForm "海店"^^xsd:string .

hd:top_weiwucun a hhto:Toponym ;
    rdfs:label "畏吾村"@zh ;
    hhto:attestedIn hd:attest_weiwucun_yuanshi ;
    hhto:phoneticPinyin "wèi wú cūn"^^xsd:string ;
    hhto:standardForm "畏吾村"^^xsd:string .

hd:top_zhongguancun_eunuch a hhto:Toponym ;
    rdfs:label "中官村"@zh ;
    hhto:attestedIn hd:attest_zhongguan_eunuch_stele ;
    hhto:phoneticPinyin "zhōng guān cūn"^^xsd:string ;
    hhto:standardForm "中官村"^^xsd:string .

hhto:HistoricalEntity a owl:Class ;
    rdfs:label "历史实体"@zh ;
    rdfs:comment "所有历史时空要素的顶层抽象基类"@zh .

hhto:ImperialNamingEvent a owl:Class ;
    rdfs:label "官方赐名改名事件"@zh ;
    rdfs:subClassOf hhto:ToponymEvolutionEvent .

hhto:ReligiousSite a owl:Class ;
    rdfs:label "宗教寺观"@zh ;
    rdfs:subClassOf hhto:AdministrativeUnit .

hhto:Watercourse a owl:Class ;
    rdfs:label "水系河道"@zh ;
    rdfs:subClassOf hhto:PhysicalFeature .

hd:feat_xiangshan a hhto:PhysicalFeature,
        hhto:TerrainElevation ;
    rdfs:label "香山与金山翠微山麓"@zh ;
    hhto:coordinatesWGS84 "116.19,39.99"^^xsd:string ;
    rdfs:comment "西山余脉，明代皇室妃嫔陵寝带与清代静宜园所在地"@zh .

hhto:PhoneticShiftEvent a owl:Class ;
    rdfs:label "语音流变与方言通假事件"@zh ;
    rdfs:subClassOf hhto:ToponymEvolutionEvent .

hhto:MilitaryGarrison a owl:Class ;
    rdfs:label "军事驻防与军屯"@zh ;
    rdfs:comment "如明代卫所小旗营屯、清代圆明园护军营八旗房、健锐营、外火器营"@zh ;
    rdfs:subClassOf hhto:AdministrativeUnit .

hd:feat_gaolianghe a hhto:PhysicalFeature,
        hhto:Watercourse ;
    rdfs:label "高梁河水系古道"@zh ;
    hhto:coordinatesWGS84 "116.35,39.95"^^xsd:string ;
    rdfs:comment "先秦古河道，自金水河上源至积水潭，元代并入通惠河干道"@zh .

hd:feat_wanquanhe a hhto:PhysicalFeature,
        hhto:Wetland ;
    rdfs:label "万泉河湿地水网"@zh ;
    hhto:coordinatesWGS84 "116.3,39.98"^^xsd:string ;
    rdfs:comment "西山山麓泉群汇聚形成的万泉河浅水洼地与湖泊沼泽区"@zh .

hhto:CompetingHypothesis a owl:Class ;
    rdfs:label "竞争假说"@zh ;
    rdfs:comment "关于地名渊源由不同学者或不同史籍提出的互斥考证假说"@zh .

hhto:TerrainElevation a owl:Class ;
    rdfs:label "山峦台地"@zh ;
    rdfs:subClassOf hhto:PhysicalFeature .

hhto:Settlement a owl:Class ;
    rdfs:label "自然聚落与市镇"@zh ;
    rdfs:subClassOf hhto:AdministrativeUnit .

hhto:PhysicalFeature a owl:Class ;
    rdfs:label "物理空间地物"@zh ;
    rdfs:comment "具有相对稳定地质、水文特征的客观自然地理底座 (Phenomenal Place)"@zh ;
    rdfs:subClassOf hhto:HistoricalEntity .

hhto:ToponymEvolutionEvent a owl:Class ;
    rdfs:label "地名演变事件"@zh ;
    rdfs:comment "触发地名更替、改字、升降或消亡的历史事件"@zh ;
    rdfs:subClassOf hhto:HistoricalEntity .

hhto:AdministrativeUnit a owl:Class ;
    rdfs:label "建置与制度实体"@zh ;
    rdfs:comment "具有制度身份、赋税职能或社群建制的历史组织单元 (Declarative Place)"@zh ;
    rdfs:subClassOf hhto:HistoricalEntity .

hhto:Toponym a owl:Class ;
    rdfs:label "地名称号实体"@zh ;
    rdfs:comment "作为语言符号、社会称谓而存在的专有地名字符串与名号 (Appellation)"@zh ;
    rdfs:subClassOf hhto:HistoricalEntity .

hhto:PlaceAttestation a owl:Class ;
    rdfs:label "史料书证凭证"@zh ;
    rdfs:comment "具体史料文本在特定断代对该地名的一次实证用例 (Attestation as a First-class Node)"@zh ;
    rdfs:subClassOf hhto:HistoricalEntity .

