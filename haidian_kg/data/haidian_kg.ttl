hd:unit_yimuyuan_fields a hhto:AdministrativeUnit,
        hhto:Settlement ;
    rdfs:label "一亩园与娘娘庙会"@zh ;
    hhto:locatedAtFeature hd:feat_wanquanhe ;
    hhto:namedAs hd:top_yimuyuan ;
    rdfs:comment "圆明园大宫门前附属空间与现代社区；乾隆朝图档见建筑院落、道路、水渠、土山（L1）。京西娘娘庙会（泰山圣母庙，『康熙重建、光绪再建』L2/L3）所在地。❌ 禁称『皇帝躬耕演礼之籍田』；耤田礼在先农坛"@zh .

hd:unit_youzhou_commandery a hhto:AdministrativeUnit,
